{
  "name": "Find Emails for a List of Names (Sheet → FoxAPIs → Sheet)",
  "meta": {
    "templateCredsSetupCompleted": true,
    "templateId": "mentionfox-14-find-emails-for-name-list"
  },
  "nodes": [
    {
      "parameters": {},
      "id": "1",
      "name": "Manual Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "documentId": "REPLACE_WITH_SOURCE_SHEET_ID",
        "sheetName": "Names In",
        "options": {}
      },
      "id": "2",
      "name": "Read Name List",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [420, 300]
    },
    {
      "parameters": {
        "website": "={{$json[\"Domain\"]}}",
        "name": "={{$json[\"Name\"]}}"
      },
      "id": "3",
      "name": "FoxAPIs: Find Email",
      "type": "n8n-nodes-mentionfox.foxApisFindEmail",
      "typeVersion": 1,
      "position": [640, 300],
      "credentials": {
        "foxApisApi": { "id": "REPLACE_WITH_FOXAPIS_CREDENTIAL_ID", "name": "FoxAPIs API" }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": "REPLACE_WITH_DESTINATION_SHEET_ID",
        "sheetName": "Emails Found",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Name": "={{$json[\"name\"]}}",
            "Domain": "={{$json[\"website\"]}}",
            "Email": "={{$json[\"email\"]}}",
            "Verified": "={{$json[\"verified\"]}}",
            "Found": "={{$json[\"found\"]}}",
            "CreditsUsed": "={{$json[\"credits_used\"]}}"
          }
        }
      },
      "id": "4",
      "name": "Append Found Email",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [860, 300]
    }
  ],
  "connections": {
    "Manual Start": { "main": [[{ "node": "Read Name List", "type": "main", "index": 0 }]] },
    "Read Name List": { "main": [[{ "node": "FoxAPIs: Find Email", "type": "main", "index": 0 }]] },
    "FoxAPIs: Find Email": { "main": [[{ "node": "Append Found Email", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": ["foxapis", "email-finder", "lead-generation", "google-sheets"]
}
